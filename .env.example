# =============================================
# just-workspace — Environment Variables
# =============================================
# Copy to .env and fill in values:
#   cp .env.example .env
#
# 주의: 비밀값(SECRET_KEY, DB_PASSWORD …)은 비워 둔다. 설치 관리자가 생성하여 기록한다.
#   수동 설치 시에는 아래 명령 한 줄로 빈 비밀값만 생성한다(값이 이미 있는 줄은 변경하지 않는다):
#     docker run --rm -v "$PWD/.env:/work/.env" <backend 이미지> python -m app.cli gen-secrets --merge /work/.env --in-place
#   (이미지가 없으면 변수마다: openssl rand -hex 24)
#   빈 값·예시 값·짧은 값(키 32자, 비밀번호 16자 미만)이면 백엔드가 기동하지 않는다. 로그에 변수 이름과 사유가 출력된다.
# =============================================

# ─── 구성 ───
# 접속 구성(프런트 프록시 뒤 80 평문 / 이 서버가 직접 443)은 변수가 아니라 nginx/site.d/ 의 파일로 결정한다.
# 기본값은 "앞단 프록시 뒤, 80 평문"이다 — docs/deployment.md.

# ─── 이미지 ───
# 자체 빌드 이미지의 이름은 <JW_REGISTRY>/just-workspace-<이름>:<JW_VERSION> 이다. 소스에서 빌드하는 경우 기본값을 유지한다.
#JW_REGISTRY=localhost
#JW_VERSION=latest
# 화면에 표시되는 제품 버전. 비우면 이미지에 내장된 값을 사용한다.
#JW_APP_VERSION=

# ─── 소스 코드 링크 ───
# 로그인 화면과 설정·관리 화면의 "소스 코드" 링크가 가리키는 주소(http·https). 비우면 원본 리포를 사용한다.
# 본 프로그램의 라이선스는 AGPL-3.0-or-later 이다. **수정하여 서비스하는 경우 수정한 소스의 주소로 변경한다**(이용자가 해당 소스를 입수할 수 있어야 한다).
#JW_SOURCE_URL=

# ─── 서비스 활성화 (쉼표 구분) ───
# 사용 가능: mailserver, gitea, livekit, audiorelay, onlyoffice, egress, sso, aitools, certbot
#   audiorelay — 음성채널 무손실 티어(PCM 24/48) 중계. WebSocket 은 nginx 뒤 /audiorelay/, WebTransport 는 UDP 4433
#   onlyoffice — 문서 편집 구역(docs)의 편집기. docx/xlsx/pptx 공동 편집(AGPL-3.0)
#                미사용 시 오피스 파일은 업로드·다운로드만 가능하며 편집은 불가
#   egress     — 회의 녹화(livekit 필요, 헤드리스 크롬)
#   sso        — SAML/SCIM(ws-sso) + LDAP 디렉터리(ws-ldap)
#   aitools    — SearXNG 웹검색(선택, AGPL-3.0) — 기본 off
#   certbot    — 메일/TURN 인증서(standalone 은 웹 인증서까지)
# 주의: compose 는 비활성 프로파일의 ${VAR:?} 도 검사한다. 아래 "필수" 표시 항목은 프로파일과 무관하게 설정 필수.
# 기본(권장):           mailserver,gitea,livekit
# 최소 (코어만):        (비워두기)
COMPOSE_PROFILES=mailserver,gitea,livekit

# ─── 설치된 구역 (쉼표 구분) ───
# 백엔드가 기동할 구역의 API·백그라운드 작업을 지정한다. 구역 선언은 backend/app/zones.json.
# 사용 가능: mail, chat, calendar, docs, meetings, git, ai / 부가: sso, rbi
#   비우면 전체 구역이 설치된 것으로 간주한다(기존 동작). 로그인·관리·대시보드·파일(core)은 항상 기동한다.
#   지정하지 않은 구역은 API 가 404 를 반환하고 메뉴에도 표시되지 않는다. 컨테이너는 위 COMPOSE_PROFILES 가 별도로 결정한다.
#   음성 채널은 chat 과 meetings 가 모두 있을 때만 기동한다.
# 예) 협업 기본: JW_ZONES=mail,chat,calendar,docs
JW_ZONES=

# ─── 스토리지 볼륨 ───
STORAGE_VOLUME=ws-storage-data

# ─── App ───
APP_NAME=Workspace
APP_URL=https://your-domain.com
DOMAIN=your-domain.com
DEBUG=false
# 필수(설치 관리자가 생성). 세션·토큰 서명 키 — 32자 이상.
SECRET_KEY=
# (설치 관리자가 생성) 백엔드 내부 API 키 — 메일 로그인(dovecot → /api/internal/mail-auth)과 ws-ldap 이 사용한다.
# 비우면 내부 API 가 비활성화된다(내장 메일 로그인·LDAP 불가). 32자 이상, 16진수·영숫자만 허용.
INTERNAL_API_KEY=
# 백엔드 워커 수 · CPU 상한. 비우면 워커는 CPU 수 기준 min(8, max(2, 코어 수)), CPU 는 제한 없음.
BACKEND_WORKERS=
BACKEND_CPUS=
# 번들 빌드 모바일 앱(화면을 앱에 내장하는 빌드)을 배포하는 경우에만 true. 해당 앱의 출처를 CORS 허용 목록에 포함한다.
ALLOW_NATIVE_APP_ORIGINS=false
# 0 이면 backend 기동 시 DB 스키마를 변경하지 않고 버전만 확인한다(버전이 낮으면 기동하지 않는다). 비우면 기동 시 적용 — docs/data-safety.md
#JW_MIGRATE_ON_START=
# 백업 저장 볼륨. 호스트 경로를 지정하면 다른 디스크에 저장할 수 있다. 비우면 도커 볼륨(ws-backups).
#BACKUP_VOLUME=

# ─── Branding ───
BRAND_LOGO=
BRAND_COLOR=#3B82F6

# ─── PostgreSQL ───
DB_NAME=workspace
DB_USER=workspace
# 필수(설치 관리자가 생성). 16자 이상.
DB_PASSWORD=
# 비우면 위 DB_USER·DB_PASSWORD·DB_NAME 으로 구성한다. 외부 DB 사용 시에만 지정한다:
#   postgresql+asyncpg://<사용자>:<비밀번호>@<호스트>:5432/<DB>
DATABASE_URL=

# ─── Mail Server ───
FEATURE_BUILTIN_MAILSERVER=false
DOVECOT_MASTER_USER=portal
# (설치 관리자가 생성) 내장 메일 서버 사용 시 필요. 16자 이상.
DOVECOT_MASTER_PASSWORD=

# ─── SMTP (noreply sender) ───
SMTP_HOST=mailserver
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
# 발신 계정 비밀번호(외부 SMTP 는 해당 계정의 비밀번호, 내장 메일 서버는 noreply 계정에 설정한 비밀번호)
SMTP_PASSWORD=
SMTP_FROM=noreply@your-domain.com
# 내장 메일 서버의 인증서 탐색 방식 · 메일 1통의 크기 상한(바이트). 비우면 letsencrypt · 104857600.
#MAIL_SSL_TYPE=letsencrypt
#MAIL_MESSAGE_SIZE_LIMIT=104857600

# ─── Admin ───
ADMIN_EMAILS=admin@your-domain.com

# ─── Gitea ───
GITEA_URL=http://gitea:3000
GITEA_EXTERNAL_URL=https://your-domain.com/git/
GITEA_TOKEN=
# 코드 저장소 데이터를 저장할 볼륨 또는 호스트 경로. 비우면 도커 볼륨(ws-gitea-data).
#GITEA_DATA_PATH=

# ─── 채팅 ───
# 채팅 역할·권한 엔진: legacy(기존 규칙만 적용) | shadow(기존 규칙으로 판정하고 신규 엔진과의 차이를 기록) | enforce(신규 엔진으로 판정).
# 비우면 shadow — docs/chat-permissions.md
#CHAT_PERMISSIONS_ENGINE=shadow

# ─── OAuth Provider (Gitea SSO + claude.ai MCP connector) ───
# DCR(RFC 7591 동적 클라이언트 등록) 활성화됨 — discovery 에 registration_endpoint
# (APP_URL/oauth/register) 게시. claude.ai 등 MCP 클라이언트는 커넥터 URL 만 입력하고
# 로그인하면 자동 등록됨(수동 Client ID/Secret 불필요). 동적 클라이언트는 mcp:read
# 전용 + https 정확 일치 redirect_uri 로 강제되며 시크릿은 해시로 저장됨.
# 아래 정적 맵은 계속 유효 — Gitea SSO 또는 mcp:write 가 필요한 고정 클라이언트에 사용.
# 각 클라이언트: secret(필수), redirect_uris(정확 일치 화이트리스트), scopes(허용 스코프).
# claude.ai 커넥터 예시 (읽기 전용, DCR 대신 고정 등록하는 경우):
#   {"claude-mcp":{"secret":"<openssl rand -hex 24>","redirect_uris":["https://claude.ai/api/mcp/auth_callback"],"scopes":["mcp:read"]}}
# 읽기+쓰기로 사용하려면 scopes 를 ["mcp:read","mcp:write"] 로 지정. Gitea 항목과 병합 가능:
#   {"gitea":{...},"claude-mcp":{"secret":"...","redirect_uris":["https://claude.ai/api/mcp/auth_callback"],"scopes":["mcp:read"]}}
OAUTH_CLIENTS_JSON={}
# 데스크톱 앱 클라이언트(desktop-app)는 백엔드에 내장되어 있으므로 여기에 추가할 필요가 없다.

# ─── 앱 빌드 (관리 › 앱 빌드) ───
# 관리 화면에서 안드로이드 앱을 빌드하려면 본 리포가 위치한 호스트 경로를 지정한다(backend 가 빌더 컨테이너에 마운트한다).
# 비우면 앱 빌드가 비활성화된다.
#JW_HOST_REPO=
# 안드로이드 앱 ID. 비우면 접속 주소의 호스트를 역순으로 배열하고 .workspace 를 덧붙인다(ws.example.com → com.example.ws.workspace).
# 배포 이후 변경 금지.
#ANDROID_APP_ID=
# 데스크톱·모바일 앱을 직접 빌드할 때의 변수는 .env 가 아니라 빌드 환경에서 지정한다 — apps/README.md, apps/desktop/README.md

# 동적(DCR) 클라이언트 전역 상한. /oauth/register 는 이 수를 초과하면 400 으로 거부한다(공개 등록 남용 방지).
OAUTH_DYNAMIC_CLIENTS_MAX=500

# ─── MCP 원격 커넥터 (Streamable HTTP + 레거시 SSE) ───
# 기본 인증은 위 OAuth Bearer. 아래는 헤드리스 내부 도구용 정적 키 모드이며 기본 비활성.
# 활성화하려면 둘 다 설정: MCP_INTERNAL_TOOLS_ENABLED=true + MCP_API_KEY=<랜덤>.
# 이 모드는 사용자 바인딩이 없어(관리자 폴백 제거됨) web_search 등 user 불필요 툴만 실행됨.
# MCP_ADMIN_USERNAME 은 제거됨(권한 상승 제거) — 사용·설정 금지.
MCP_INTERNAL_TOOLS_ENABLED=false
MCP_API_KEY=

# ─── LiveKit ───
# (설치 관리자가 생성) 비어 있으면 회의 기능이 비활성화되고 회의 서버 컨테이너도 기동하지 않는다. 비밀값은 32자 이상.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=http://livekit:7880
# 내장 TURN/TLS 를 게시할 호스트 포트. standalone(nginx 가 443 사용)이면 충돌을 피해 127.0.0.1:4443 으로 지정한다.
LIVEKIT_TURN_TLS_PUBLISH=443

# ─── 무손실 음성 릴레이 (profiles: audiorelay) ───
# 필수(프로파일 활성화 시, 설치 관리자가 생성). 백엔드가 발급하는 릴레이 토큰의 HMAC 시크릿 — 32자 이상, backend 와 ws-audiorelay 가 동일한 값을 읽는다.
AUDIORELAY_SECRET=
# WebTransport(HTTP/3·UDP) 공개 주소. 비우면 WebSocket 만 사용한다(리버스 프록시 뒤 /audiorelay/ 로 모든 환경에서 동작).
# 외부에서 사용하려면: DNS A 레코드 + 해당 이름의 인증서(아래 CERT/KEY) + 방화벽 UDP 4433 DNAT → 앱 서버:4433.
# 예: https://relay.your-domain.com:4433/audiorelay/wt  (LAN 테스트: https://192.168.10.20:4433/audiorelay/wt — 자가서명 자동)
AUDIORELAY_WT_PUBLIC_URL=
AUDIORELAY_WT_PORT=4433
# WebTransport 인증서(컨테이너 내부 경로, certbot-data 볼륨이 /etc/letsencrypt 에 마운트된다). 둘 다 없으면 유효기간 13일의 자가서명 인증서를
# 생성하고 /audiorelay/info 에 cert_hash 를 게시한다(브라우저 serverCertificateHashes) — LAN·테스트 전용.
AUDIORELAY_WT_CERT=/etc/letsencrypt/live/${DOMAIN}/fullchain.pem
AUDIORELAY_WT_KEY=/etc/letsencrypt/live/${DOMAIN}/privkey.pem
# 자가서명 SAN(IP·이름, 쉼표). 운영(실인증서)에서는 무시된다.
AUDIORELAY_WT_SELF_SIGNED_HOSTS=127.0.0.1,localhost

# ─── 격리 브라우저 RBI (profiles: rbi) ───
# 내부 웹 자산을 세션별 일회용 브라우저 컨테이너(KasmVNC)로만 연다. 모듈 "격리 브라우저" 를 관리 화면에서 활성화하고 대상을 등록한다(docs/rbi.md).
# 격리 브라우저 전용 출처 — 워크스페이스와 상이한 출처(쿠키가 전달되지 않는다). 호스트는 rbi. 로 시작(ws-nginx server_name).
# 프런트 리버스 프록시에 이 이름의 443 → ws-nginx:80 을 구성하고(Host $host, WebSocket), DNS 를 동일한 공인 IP 로 지정한다. 비우면 격리 브라우저 사용 불가. docs/rbi.md §7
RBI_PUBLIC_ORIGIN=https://rbi.your-domain.com
# rbi 출처 세션 수명(시간). 워크스페이스에서 로그아웃하면 그 전에 종료된다
#RBI_SITE_SESSION_HOURS=8
# 출구 허용 목록은 관리 › 격리 브라우저에서 추가한 대상으로 동적 생성한다(재시작 불필요, docs/rbi.md §8).
# RBI_ALLOW 는 고정 허용(항상 허용, "IP:포트" 쉼표 구분) — 통상 비운다.
RBI_ALLOW=
# 동적 출구 상한(CIDR 쉼표 구분, 비우면 사설 대역 10/8·172.16/12·192.168/16) · 사이드카가 항상 거부할 CIDR 추가
#RBI_ALLOW_CEILING=192.168.10.0/24
#RBI_DENY=
# 워크스페이스 자신의 주소(앱 호스트·LAN 게이트웨이) — 대상으로 지정 시 거부, 관리자가 강제하면 경고·감사 기록과 함께 허용
RBI_PROTECTED=192.168.10.20,192.168.10.1
# 세션 컨테이너 이미지(kasmweb/chromium — KasmVNC 기반 Chromium, 비루트·읽기 전용으로 기동한다) — 픽셀 모드
RBI_IMAGE=kasmweb/chromium:1.18.0
# 미러 모드 세션 이미지(rbi/mirror — docker compose build rbi-mirror). 비우면 ${JW_REGISTRY:-localhost}/just-workspace-rbi-mirror:${JW_VERSION:-latest}
#RBI_MIRROR_IMAGE=localhost/just-workspace-rbi-mirror:latest
# 세션 전용 브리지(없으면 백엔드가 생성한다). 브리지 이름은 netfilter 사이드카가 규칙을 적용할 때 그대로 사용한다.
RBI_NETWORK=ws-rbi
RBI_SUBNET=172.31.200.0/24
RBI_IP_RANGE=172.31.200.128/25
RBI_BRIDGE=br-wsrbi
# ws-nginx 가 세션 스트림에 접속하는 주소(workspace 브리지 게이트웨이) — 변경할 필요가 거의 없음
RBI_PUBLISH_IP=172.28.0.1
# 동시 세션 상한(세션당 기본 2 CPU / 2 GB)
RBI_MAX_SESSIONS=4
# netfilter 사이드카 하트비트가 없으면 세션을 기동하지 않는다(fail-closed). 격리 없이 시험하는 경우에만 false.
RBI_REQUIRE_GUARD=true

# ─── OnlyOffice / SearXNG ───
# (설치 관리자가 생성) 해당 프로파일 활성화 시 필요. 32자 이상.
ONLYOFFICE_JWT_SECRET=
SEARXNG_SECRET=

# ─── AI 파일 도구 컨테이너 (profiles: aitools) ───
# ws-sandbox(code_run) 공유 비밀 — 백엔드와 샌드박스가 동일한 값을 읽는다. 비우면 분석 실행이 전부 거부된다.
#   (설치 관리자가 생성) 32자 이상
SANDBOX_TOKEN=
# ws-docconv(files_convert) 공유 비밀(선택 — 네트워크가 없는 컨테이너이므로 비워도 소켓 볼륨 외부에서는 접근 불가)
DOCCONV_TOKEN=
# 상한(선택): 동시 실행 수·최대 실행 초·실행당 메모리(MB) / 동시 변환 수·변환 초·파일 MB
# SANDBOX_CONCURRENCY=2
# SANDBOX_MAX_TIMEOUT=120
# SANDBOX_MEM_MB=1536
# DOCCONV_CONCURRENCY=2
# DOCCONV_TIMEOUT=120
# DOCCONV_MAX_MB=100

# ─── 초기 관리자 ───
# 사용자가 한 명도 없는 경우(첫 기동)에만 이 값으로 관리자를 생성한다. 이후에는 읽지 않으므로 **생성 후 삭제한다**
# (평문 비밀번호가 파일에 남지 않도록). 동일한 이름의 계정이 이미 있어도 관리자로 승격하지 않는다.
# .env 에 기록하지 않고 생성: docker compose exec backend python -m app.cli seed-admin --username <아이디>
# 둘 다 비운 채 기동하면 웹의 최초 설정 화면(/setup)에서 생성한다 — backend 로그에 출력되는 설정 토큰이 필요하다
# (docker compose logs backend | grep "setup token", 재발급: … python -m app.cli setup-token).
# 관리자 비밀번호 분실 시: docker compose exec backend python -m app.cli reset-admin <아이디> [--disable-2fa]
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── LDAP 디렉터리 (profiles: sso) ───
# 외부에 개방하는 포트는 LDAPS(636)뿐이다. 평문 389 는 기본적으로 이 서버 자신(127.0.0.1)에만 개방한다.
# 평문만 지원하는 장비가 동일 내부망에 있는 경우에만 해당 망의 서버 주소를 지정한다(예: 192.168.10.20). 0.0.0.0 은 사용 금지.
LDAP_PLAIN_BIND=127.0.0.1

# ─── Git SSH ───
GIT_SSH_PORT=2222

# ─── Let's Encrypt ───
LETSENCRYPT_EMAIL=admin@your-domain.com
# certbot 이 발급받을 이름 목록(쉼표 구분). 인증서 디렉터리는 첫 이름을 따른다. DNS 가 없는 이름이 포함되면 전체 실패.
# 비우면 mail.<도메인>,turn.<도메인>,<도메인>
ACME_DOMAINS=

# MCP 리소스 서버의 공개 주소 — 전용 하위 도메인으로 별도 수신하는 경우에만 지정한다(예 https://mcp.your-domain.com).
# 비우면 APP_URL 을 사용한다. docs/CONNECTOR.md
MCP_PUBLIC_URL=

# 리버스 프록시 VM 의 LAN 주소 (컨테이너가 공인 도메인으로 헤어핀 NAT 을 통과하지 못하는 경우의 우회용).
# 비우면 우회가 비활성화된다.
RP_LAN_IP=
# 동일한 앱을 다른 도메인으로도 서비스하는 경우 그 이름(헤어핀 우회 대상에 추가). 선택.
DOMAIN_ALIAS=

# GPU 워크로드를 다른 머신에서 실행하는 경우 그 호스트 IP(백엔드 extra_hosts). 선택.
GPU_HOST_IP=

# ─── 내부 대역 · 헤어핀 우회 이름 · Git 표기 ───
# 컨테이너 내부 대역의 앞 세 옥텟(/24 고정). 기존 도커 네트워크·사내 대역과 중복되는 경우에만 변경한다(예 172.30.5).
# 변경 시 RBI_PUBLISH_IP 도 동일 대역의 .1 로 변경한다.
#JW_NET_PREFIX=172.28.0
# RP_LAN_IP 로 우회할 이름. 비우면 DOMAIN. 우회가 불필요하면 사용하지 않는 이름(hairpin-off.invalid)을 지정한다.
#HAIRPIN_HOST=
# Gitea 이미지. 비우면 compose 에 고정된(검증된) 버전.
#GITEA_IMAGE=
# Git SSH 주소에 표시할 호스트 이름. 비우면 DOMAIN.
#GIT_SSH_DOMAIN=

# ─── 저장소 마커 ───
# 1 이면 저장소 루트의 마커 파일(.jw-storage)이 확인되지 않을 때 파일 쓰기를 503 으로 거부한다
# (연결이 끊긴 네트워크 저장소 위치의 빈 폴더에 기록하는 사고 방지). 설치 관리자가 마커를 기록하고 이 값을 활성화한다.
#STORAGE_MARKER_REQUIRED=
#JW_INSTALL_ID=
