# =============================================
# just-workspace — Environment Variables
# =============================================
# Copy to .env and fill in values:
#   cp .env.example .env
# =============================================

# ─── Deploy Mode ───
# external_proxy — HTTP :80, SSL handled by external reverse proxy
# standalone     — HTTPS :80+:443, Let's Encrypt auto-certificate
# dev            — HTTP :80, no SSL
DEPLOY_MODE=external_proxy

# ─── 서비스 활성화 (쉼표 구분) ───
# 사용 가능: mailserver, gitea, livekit, audiorelay, onlyoffice, egress, logging, sso, aitools, certbot
#   audiorelay — 음성채널 무손실 티어(PCM 24/48) 중계. WebSocket 은 nginx 뒤 /audiorelay/, WebTransport 는 UDP 4433
#   onlyoffice — 업로드한 docx/xlsx/pptx 를 그 자리에서 편집(선택, AGPL-3.0)
#                문서·시트는 자체 편집기(.jwdoc/.jwsheet)를 쓰므로 없어도 된다
#   egress     — 회의 녹화(livekit 필요, 헤드리스 크롬)
#   logging    — Loki/Grafana/헬스프로브 관제
#   sso        — SAML/SCIM(ws-sso) + LDAP 디렉터리(ws-ldap)
#   aitools    — SearXNG 웹검색(선택, AGPL-3.0) — 기본 off
#   certbot    — 메일/TURN 인증서(standalone 은 웹 인증서까지)
# ★ compose 는 꺼진 프로파일의 ${VAR:?} 도 검사한다 — 아래 "필수" 표시는 프로파일과 무관하게 채울 것.
# 기본(권장):           mailserver,gitea,livekit
# 최소 (코어만):        (비워두기)
COMPOSE_PROFILES=mailserver,gitea,livekit

# ─── 설치된 구역 (쉼표 구분) ───
# 백엔드가 어느 구역의 API·백그라운드 작업을 올릴지 정한다. 구역 선언은 backend/app/zones.json.
# 사용 가능: mail, chat, calendar, docs, meetings, git, ai, monitoring / 부가: sso, rbi
#   비워두면 전부 설치된 것으로 본다(기존 동작). 로그인·관리·대시보드·파일(core)은 늘 올라온다.
#   적지 않은 구역은 API 가 404 이고 메뉴에도 나오지 않는다. 컨테이너는 위 COMPOSE_PROFILES 가 따로 정한다.
#   음성 채널은 chat 과 meetings 가 둘 다 있을 때만 올라온다.
# 예) 협업 기본: JW_ZONES=mail,chat,calendar,docs
JW_ZONES=

# ─── 스토리지 볼륨 ───
STORAGE_VOLUME=ws-storage-data

# ─── App ───
APP_NAME=Workspace
APP_URL=https://your-domain.com
DOMAIN=your-domain.com
DEBUG=false
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET
# 필수. 백엔드 내부 API 키 — 메일 로그인(dovecot → /api/internal/mail-auth)과 ws-ldap 이 쓴다.
INTERNAL_API_KEY=CHANGE_ME

# ─── Branding ───
BRAND_LOGO=
BRAND_COLOR=#3B82F6

# ─── PostgreSQL ───
DB_NAME=workspace
DB_USER=workspace
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://workspace:CHANGE_ME_TO_STRONG_PASSWORD@postgres:5432/workspace

# ─── Mail Server ───
FEATURE_BUILTIN_MAILSERVER=false
DOVECOT_MASTER_USER=portal
DOVECOT_MASTER_PASSWORD=CHANGE_ME

# ─── SMTP (noreply sender) ───
SMTP_HOST=mailserver
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@your-domain.com

# ─── Admin ───
ADMIN_EMAILS=admin@your-domain.com

# ─── Gitea ───
GITEA_URL=http://gitea:3000
GITEA_EXTERNAL_URL=https://your-domain.com/git/
GITEA_TOKEN=

# ─── OAuth Provider (Gitea SSO + claude.ai MCP connector) ───
# DCR(RFC 7591 동적 클라이언트 등록) 활성화됨 — discovery 에 registration_endpoint
# (APP_URL/oauth/register) 광고. claude.ai 등 MCP 클라이언트는 커넥터 URL 만 입력하고
# 로그인하면 자동 등록됨(수동 Client ID/Secret 불필요). 동적 클라이언트는 mcp:read
# 전용 + https 정확일치 redirect_uri 로 강제되고 시크릿은 해시 저장됨.
# 아래 정적 맵은 여전히 유효 — Gitea SSO나 mcp:write 가 필요한 고정 클라이언트에 사용.
# 각 클라이언트: secret(필수), redirect_uris(정확 일치 화이트리스트), scopes(허용 스코프).
# claude.ai 커넥터 예시 (읽기 전용, DCR 대신 고정 등록하려는 경우):
#   {"claude-mcp":{"secret":"<openssl rand -hex 24>","redirect_uris":["https://claude.ai/api/mcp/auth_callback"],"scopes":["mcp:read"]}}
# 읽기+쓰기로 쓰려면 scopes 를 ["mcp:read","mcp:write"] 로. Gitea 항목과 병합 가능:
#   {"gitea":{...},"claude-mcp":{"secret":"...","redirect_uris":["https://claude.ai/api/mcp/auth_callback"],"scopes":["mcp:read"]}}
OAUTH_CLIENTS_JSON={}
# 데스크톱 앱 클라이언트(desktop-app)는 백엔드에 내장돼 있어 여기 넣지 않아도 된다.

# ─── 데스크톱 앱 빌드 ───
# 비우면 APP_URL 로 빌드하고 앱 ID 는 도메인에서 만든다. 앱 ID 는 한 번 배포하면 바꾸지 말 것.
#DESKTOP_SERVER_URL=
#DESKTOP_APP_ID=
#DESKTOP_PRODUCT_NAME=
#DESKTOP_CSC_LINK=
#DESKTOP_CSC_KEY_PASSWORD=
# 앱(데스크톱·안드로이드)이 여는 웹 UI: vue | react (비우면 vue). React 병행 기간용 스위치 —
# 앱이 서버 nginx 의 UI 전환 쿠키(jw_ui)를 심는다. 바꾼 뒤 앱을 다시 빌드해야 반영된다.
#JW_WEB=
# 안드로이드 번들 모드(1 이면 React 판을 앱 안에 넣고 API 만 서버로. JW_WEB=react 필요, CLI mobile build 전용)
#ANDROID_WEB_BUNDLE=
# 동적(DCR) 클라이언트 전역 상한. /oauth/register 는 이 수를 넘으면 400 거부(오픈등록 남용 방지).
OAUTH_DYNAMIC_CLIENTS_MAX=500

# ─── MCP 원격 커넥터 (Streamable HTTP + 레거시 SSE) ───
# 기본 인증은 위 OAuth Bearer. 아래는 헤드리스 내부 도구용 정적키 모드로 기본 비활성.
# 활성화하려면 둘 다 설정: MCP_INTERNAL_TOOLS_ENABLED=true + MCP_API_KEY=<랜덤>.
# 이 모드는 사용자 바인딩이 없어(관리자 폴백 제거됨) web_search 등 user 불필요 툴만 실행됨.
# MCP_ADMIN_USERNAME 은 제거됨(권한상승 제거) — 더 이상 사용/설정하지 말 것.
MCP_INTERNAL_TOOLS_ENABLED=false
MCP_API_KEY=

# ─── LiveKit ───
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=http://livekit:7880
# 내장 TURN/TLS 를 게시할 호스트 포트. standalone(nginx 가 443)이면 127.0.0.1:4443 으로 비켜 둔다.
LIVEKIT_TURN_TLS_PUBLISH=443

# ─── 무손실 음성 릴레이 (profiles: audiorelay) ───
# 필수(프로파일 켤 때). 백엔드가 발급하는 릴레이 토큰의 HMAC 시크릿 — 16자 이상, backend 와 ws-audiorelay 가 같은 값을 읽는다.
AUDIORELAY_SECRET=CHANGE_ME_TO_RANDOM_SECRET
# WebTransport(HTTP/3·UDP) 공개 주소. 비우면 WebSocket 만 쓴다(리버스 프록시 뒤 /audiorelay/ 로 어디서나 동작).
# 외부에서 쓰려면: DNS A 레코드 + 그 이름의 인증서(아래 CERT/KEY) + 방화벽 UDP 4433 DNAT → 앱 서버:4433.
# 예: https://relay.your-domain.com:4433/audiorelay/wt  (LAN 테스트: https://192.168.10.20:4433/audiorelay/wt — 자가서명 자동)
AUDIORELAY_WT_PUBLIC_URL=
AUDIORELAY_WT_PORT=4433
# WebTransport 인증서(컨테이너 안 경로, certbot-data 볼륨이 /etc/letsencrypt 로 붙는다). 둘 다 없으면 13일짜리 자가서명을
# 만들고 /audiorelay/info 에 cert_hash 를 게시한다(브라우저 serverCertificateHashes) — LAN·테스트 전용.
AUDIORELAY_WT_CERT=/etc/letsencrypt/live/${DOMAIN}/fullchain.pem
AUDIORELAY_WT_KEY=/etc/letsencrypt/live/${DOMAIN}/privkey.pem
# 자가서명 SAN(IP·이름, 쉼표). 운영(실인증서)에서는 무시된다.
AUDIORELAY_WT_SELF_SIGNED_HOSTS=127.0.0.1,localhost

# ─── 격리 브라우저 RBI (profiles: rbi) ───
# 내부 웹 자산을 세션별 일회용 브라우저 컨테이너(KasmVNC)로만 연다. 모듈 "격리 브라우저" 를 관리에서 켜고 대상을 등록한다(docs/rbi.md).
# 격리 브라우저 전용 출처 — 워크스페이스와 다른 출처(쿠키가 건너가지 않는다). 호스트는 rbi. 로 시작(ws-nginx server_name).
# 앞단 리버스 프록시에 이 이름의 443 → ws-nginx:80 을 두고(Host $host, WebSocket), DNS 를 같은 공인 IP 로. 비우면 격리 브라우저를 쓸 수 없다. docs/rbi.md §7
RBI_PUBLIC_ORIGIN=https://rbi.your-domain.com
# rbi 출처 세션 수명(시간). 워크스페이스 로그아웃이면 그 전에 끝난다
#RBI_SITE_SESSION_HOURS=8
# 출구 허용 목록은 관리 › 격리 브라우저에서 더한 대상으로 동적으로 만든다(재시작 없음, docs/rbi.md §8).
# RBI_ALLOW 는 고정 허용(늘 허용, "IP:포트" 쉼표) — 보통 비운다.
RBI_ALLOW=
# 동적 출구 상한(CIDR 쉼표, 비면 사설 대역 10/8·172.16/12·192.168/16) · 사이드카가 언제나 거부할 CIDR 추가
#RBI_ALLOW_CEILING=192.168.0.0/24
#RBI_DENY=
# 워크스페이스 자신의 주소(앱 호스트·LAN 게이트웨이) — 대상으로 거부, 관리자가 강제하면 경고·감사와 함께 허용
RBI_PROTECTED=192.168.10.20,192.168.10.1
# 세션 컨테이너 이미지(kasmweb/chromium — KasmVNC 기반 Chromium, 비루트·읽기전용으로 띄운다) — 픽셀 모드
RBI_IMAGE=kasmweb/chromium:1.18.0
# 미러 모드 세션 이미지(rbi/mirror — docker compose build rbi-mirror). 비우면 ${JW_REGISTRY:-localhost}/just-workspace-rbi-mirror:${JW_VERSION:-latest}
#RBI_MIRROR_IMAGE=localhost/just-workspace-rbi-mirror:latest
# 세션 전용 브리지(백엔드가 없으면 만든다). 브리지 이름은 netfilter 사이드카가 규칙을 걸 때 그대로 쓴다.
RBI_NETWORK=ws-rbi
RBI_SUBNET=172.31.200.0/24
RBI_IP_RANGE=172.31.200.128/25
RBI_BRIDGE=br-wsrbi
# ws-nginx 가 세션 스트림을 찌르는 주소(workspace 브리지 게이트웨이) — 바꿀 일 거의 없음
RBI_PUBLISH_IP=172.28.0.1
# 동시 세션 상한(세션당 기본 2 CPU / 2 GB)
RBI_MAX_SESSIONS=4
# netfilter 사이드카 하트비트가 없으면 세션을 띄우지 않는다(fail-closed). 격리 없이 시험할 때만 false.
RBI_REQUIRE_GUARD=true

# ─── OnlyOffice / SearXNG ───
ONLYOFFICE_JWT_SECRET=CHANGE_ME
SEARXNG_SECRET=CHANGE_ME

# ─── AI 파일 도구 컨테이너 (profiles: aitools) ───
# ws-sandbox(code_run) 공유 비밀 — 백엔드와 샌드박스가 같은 값을 읽는다. 비우면 분석 실행이 모두 거절된다.
#   생성: openssl rand -hex 32
SANDBOX_TOKEN=
# ws-docconv(files_convert) 공유 비밀(선택 — 네트워크 없는 컨테이너라 비워도 소켓 볼륨 밖에선 못 닿는다)
DOCCONV_TOKEN=
# 상한(선택): 동시 실행 수·최대 실행 초·실행당 메모리(MB) / 동시 변환 수·변환 초·파일 MB
# SANDBOX_CONCURRENCY=2
# SANDBOX_MAX_TIMEOUT=120
# SANDBOX_MEM_MB=1536
# DOCCONV_CONCURRENCY=2
# DOCCONV_TIMEOUT=120
# DOCCONV_MAX_MB=100

# ─── 관제 (profiles: logging) ───
# 필수(프로파일과 무관하게 compose 가 검사).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# 포트를 게시할 주소 — 공인 인터페이스에 열지 말 것(LAN IP 또는 127.0.0.1).
GRAFANA_BIND=127.0.0.1
# Loki 수신 게이트웨이(ws-loki-gw, :3102) — 다른 호스트가 push 만 하는 입구.
#   LOKI_PUSH_BIND  게시 주소(LAN IP). 127.0.0.1 이면 사실상 꺼짐
#   LOKI_PUSH_ALLOW 허용 출발지 IP/CIDR(쉼표 구분). 나머지는 403
LOKI_PUSH_BIND=127.0.0.1
LOKI_PUSH_ALLOW=127.0.0.1
ALERT_EMAIL=admin@your-domain.com
# 헬스프로브의 사이트 전용 점검. 비우면 건너뛴다.
#   RP_IP — 앞단 리버스 프록시(웹 인증서 만료 점검)
#   TUNNEL_IP / TUNNEL_PROBE_HOST — 터널 경유 경로 점검(터널 끝 프록시 IP / 그 프록시로 열어 볼 호스트 이름)
#   NETLAB_HOST — NetLab 출처 이름(리버스 프록시 경유 /healthz + 인증서). RP_IP 도 필요
RP_IP=
TUNNEL_IP=
TUNNEL_PROBE_HOST=
NETLAB_HOST=

# ─── 초기 관리자 (시드 완료 후 삭제 권장) ───
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── Git SSH ───
GIT_SSH_PORT=2222

# ─── Let's Encrypt ───
LETSENCRYPT_EMAIL=admin@your-domain.com
# certbot 이 받을 이름들(쉼표). 인증서 디렉터리는 첫 이름을 따른다. DNS 없는 이름이 섞이면 전체 실패.
# 비우면 mail.<도메인>,turn.<도메인>,<도메인>
ACME_DOMAINS=

# MCP resource server public URL (dedicated subdomain). Empty falls back to APP_URL.
MCP_PUBLIC_URL=https://mcp.example.com

# 리버스 프록시 VM 의 LAN 주소 (컨테이너가 공인 도메인으로 헤어핀 NAT 을 못 넘을 때 우회용).
# 비워두면 우회가 비활성된다.
RP_LAN_IP=
# 같은 앱을 다른 도메인으로도 서빙하면 그 이름(헤어핀 우회 대상에 추가). 선택.
DOMAIN_ALIAS=

# GPU 워크로드를 다른 머신에서 돌리면 그 호스트 IP(백엔드 extra_hosts). 선택.
GPU_HOST_IP=
