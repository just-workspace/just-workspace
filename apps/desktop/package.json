{
  "name": "just-workspace-desktop",
  "version": "0.5.6",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Just Workspace 데스크톱 클라이언트",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs && node scripts/build-runner.mjs && node scripts/site.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && node scripts/site.mjs --require && electron-builder --config electron-builder.config.cjs",
    "native:build": "node scripts/native-build.mjs",
    "native:build:node": "node scripts/native-build.mjs --runtime node",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "dist:support": "npm run build && electron-builder --config electron-builder.support.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "24.19.2",
    "@types/ws": "^8.18.2",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "node-addon-api": "8.9.2",
    "node-gyp": "13.1.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@fails-components/webtransport": "1.6.11",
    "@fails-components/webtransport-transport-http3-quiche": "1.6.11",
    "livekit-client": "2.24.0",
    "ws": "^8.23.0"
  },
  "author": "Just Workspace contributors",
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
