{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vitest/globals", "node"],
    
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "vite.rbi.config.ts", "rbi-bundle-guard.ts", "vite.installer.config.ts", "installer-bundle-guard.ts", "vitest.config.ts", "eslint.config.js"]
}
