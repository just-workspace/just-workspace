    {
      "type": "stat",
      "title": "실패 중인 점검",
      "description": "최근 15분 안에 error/critical 로 보고된 점검 건수. 0 이 아니면 아래 표를 본다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"ws-healthprobe\"} | json | status =~ \"error|critical\" [15m]))"
