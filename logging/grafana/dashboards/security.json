{
  "uid": "ws-log-security",
  "title": "워크스페이스 — 보안 이벤트",
  "tags": ["workspace", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "인증 실패 (24시간)",
      "description": "LDAP bind 실패, 401/403, invalid credentials 를 통틀어 센다. 평소보다 급증하면 무차별 대입을 의심한다.",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=~\".+\"} |~ `(?i)(invalid credentials|401|403|unauthorized|bind 실패|authentication fail)` [24h]))",
          "queryType": "instant"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "OAuth 동의 발급 (24시간)",
      "description": "새 클라이언트가 사용자 데이터 접근을 승인받은 횟수. 예상보다 많으면 확인이 필요하다.",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"ws-backend\"} |= `OAuth consent granted` [24h]))",
          "queryType": "instant"
        }
      ],
      "options": { "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "동적 클라이언트 등록 (24시간)",
      "description": "/oauth/register 는 인증 없이 열려 있다. 예상치 못한 등록이 보이면 조사할 것.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"ws-backend\"} |= `DCR: registered dynamic client` [24h]))",
          "queryType": "instant"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "인증 실패 추이",
      "description": "완만한 배경 잡음과 뾰족한 급증을 구분하는 것이 목적이다.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate({service=~\".+\"} |~ `(?i)(invalid credentials|401|403|unauthorized|bind 실패)` [10m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 20, "showPoints": "never" } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "LDAP bind 기록",
      "description": "ws-ldap 은 성공/실패를 모두 남긴다. 어떤 계정이 어디서 붙는지 확인용.",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "{service=\"ws-ldap\"} |~ `bind` " }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "인증·인가 관련 원문",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\".+\"} |~ `(?i)(invalid credentials|unauthorized|forbidden|consent|token_version|permission denied)`"
        }
      ],
      "options": { "showTime": true, "showLabels": true, "sortOrder": "Descending", "wrapLogMessage": true }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "CSP 위반 (Report-Only 수집분)",
      "description": "여기가 조용해지면 CSP 를 강제(enforce)로 전환할 수 있다.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "expr": "{service=\"ws-backend\"} |= `[csp]`" }
      ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true }
    }
  ]
}
