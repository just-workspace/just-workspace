# Loki 수신 게이트웨이 — 다른 호스트가 로그를 밀어 넣는 유일한 입구.
#
# Loki 자체는 내부망(172.28.0.71)에만 있고 인증이 없다(auth_enabled: false). 그대로 LAN 에
# 게시하면 LAN 의 누구나 로그를 읽고(쿼리 API) 지울 수 있다. 그래서:
#   - push 경로 하나만 연다(조회·삭제·관리 API 는 403)
#   - 출발지를 LOKI_PUSH_ALLOW(사이트 .env, 쉼표 구분)로
#     제한한다. 목록은 10-push-allow.sh 가 push-allow.inc 로 풀어 둔다.
#   - 게시 주소는 LOKI_PUSH_BIND(기본 127.0.0.1 = 사실상 꺼짐)
# 도커 게시 포트는 호스트 방화벽(ufw)을 거치지 않으므로 출발지 제한은 여기서 한다.
# (도커 호스트가 인바운드를 SNAT 하지 않아야 $remote_addr 가 실제 출발지다 — 리눅스 도커 엔진 기본.)
server {
    listen 3100;
    server_tokens off;
    access_log off;
    client_max_body_size 8m;

    location = /loki/api/v1/push {
        include /etc/nginx/push-allow.inc;
        deny all;
        limit_except POST { deny all; }
        proxy_pass http://172.28.0.71:3100;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location = /ready {
        include /etc/nginx/push-allow.inc;
        deny all;
        proxy_pass http://172.28.0.71:3100;
    }

    location / { return 403; }
}
